# .gitignore lists files that git should NOT track or upload.
# One pattern per line. A line starting with # is a comment.
# A folder name ending in / ignores that whole folder.
# * matches anything, so *.pyc means "every file ending in .pyc".
# A line starting with ! makes an exception to an earlier pattern.

# --- Python leftovers (created automatically, never needed in git)
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Virtual environments (each person makes their own)
.venv/
venv/

# --- Real data and papers: never commit, this repository is public
data/
*.pdf
# ...except the synthetic guide that belongs to the datasets
!datasets/documents/*.pdf

# --- Things your code will create (can always be made again)
outputs/
*.pt

# --- Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
/graphify-out
